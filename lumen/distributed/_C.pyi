from datetime import timedelta
from typing import Sequence, final

Timeout = timedelta | float

@final
class DeviceMesh:
    def __new__(
        cls, device_type: str, mesh: Sequence, *, mesh_dim_names: Sequence[str] | None = None
    ) -> "DeviceMesh": ...
    @property
    def device_type(self) -> str: ...
    @property
    def mesh(self) -> list: ...
    @property
    def mesh_dim_names(self) -> tuple[str, ...] | None: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def ndim(self) -> int: ...
    def size(self, mesh_dim: int | str | None = None) -> int: ...
    def get_rank(self) -> int: ...
    def get_local_rank(self, mesh_dim: int | str | None = None) -> int: ...
    def get_coordinate(self) -> list[int] | None: ...
    def __getitem__(self, mesh_dim_names: str | tuple[str, ...]) -> "DeviceMesh": ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

def init_device_mesh(
    device_type: str, mesh_shape: Sequence[int], *, mesh_dim_names: Sequence[str] | None = None
) -> DeviceMesh: ...
def get_rank() -> int: ...
def get_world_size() -> int: ...
@final
class TCPStore:
    def __new__(
        cls, host_name: str, port: int, *, is_master: bool = False, timeout: Timeout | None = None
    ) -> "TCPStore": ...
    @property
    def host(self) -> str: ...
    @property
    def port(self) -> int: ...
    def set(self, key: str, value: str | bytes) -> None: ...
    def get(self, key: str) -> bytes: ...
    def add(self, key: str, amount: int) -> int: ...
    def wait(self, keys: Sequence[str], timeout: Timeout | None = None) -> None: ...

def init_process_group(
    *,
    init_method: str | None = None,
    timeout: Timeout | None = None,
    world_size: int = -1,
    rank: int = -1,
    store: TCPStore | None = None,
) -> None: ...
def destroy_process_group() -> None: ...
def is_initialized() -> bool: ...
def _barrier(ranks: Sequence[int]) -> None: ...
