from datetime import timedelta
from typing import Optional, Sequence, Union, final

Timeout = Union[timedelta, float]

@final
class DeviceMesh:
    def __new__(
        cls, device_type: str, mesh: Sequence, *, mesh_dim_names: Optional[Sequence[str]] = None
    ) -> "DeviceMesh": ...
    @property
    def device_type(self) -> str: ...
    @property
    def mesh(self) -> list: ...
    @property
    def mesh_dim_names(self) -> Optional[tuple[str, ...]]: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def ndim(self) -> int: ...
    def size(self, mesh_dim: Optional[Union[int, str]] = None) -> int: ...
    def get_rank(self) -> int: ...
    def get_local_rank(self, mesh_dim: Optional[Union[int, str]] = None) -> int: ...
    def get_coordinate(self) -> Optional[list[int]]: ...
    def __getitem__(self, mesh_dim_names: Union[str, tuple[str, ...]]) -> "DeviceMesh": ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

def init_device_mesh(
    device_type: str, mesh_shape: Sequence[int], *, mesh_dim_names: Optional[Sequence[str]] = None
) -> DeviceMesh: ...
def get_rank() -> int: ...
def get_world_size() -> int: ...
@final
class TCPStore:
    def __new__(
        cls, host_name: str, port: int, *, is_master: bool = False, timeout: Optional[Timeout] = None
    ) -> "TCPStore": ...
    @property
    def host(self) -> str: ...
    @property
    def port(self) -> int: ...
    def set(self, key: str, value: Union[str, bytes]) -> None: ...
    def get(self, key: str) -> bytes: ...
    def add(self, key: str, amount: int) -> int: ...
    def wait(self, keys: Sequence[str], timeout: Optional[Timeout] = None) -> None: ...

def init_process_group(
    *,
    init_method: Optional[str] = None,
    timeout: Optional[Timeout] = None,
    world_size: int = -1,
    rank: int = -1,
    store: Optional[TCPStore] = None,
) -> None: ...
def destroy_process_group() -> None: ...
def is_initialized() -> bool: ...
