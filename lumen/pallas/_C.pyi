from typing import Any, Optional, Sequence

class Kernel:
    """A TPU kernel being traced (``lumen.pallas``): its values are traced
    tensors of it, its refs ``lumen.pallas.Ref``s (``lumen/pallas/``)."""

    def __init__(self, scalars: int, rows: int, host_rows: Optional[int] = None) -> None: ...
    def params(self) -> list[int]: ...
    def vmem(self, dtype: str, shape: Sequence[int]) -> int: ...
    def semaphores(self, shape: Sequence[int]) -> int: ...
    def apply(self, name: str, inputs: Sequence[int], params: Optional[dict[str, Any]] = None) -> int: ...
    def bits(
        self, name: str, inputs: Sequence[int], dtype: Optional[str] = None, multiple: Optional[int] = None
    ) -> int: ...
    def type_of(self, var: int) -> tuple[str, list[int]]: ...
    def ref_type(self, var: int) -> tuple[str, list[int], str]: ...
    def slice(
        self,
        src: int,
        starts: Sequence[Optional[int]],
        dynamic: Sequence[int],
        sizes: Sequence[int],
        squeezed: Sequence[bool],
    ) -> int: ...
    def view(self, memory: int, row: int, dtype: str, shape: Sequence[int]) -> int:
        """A ``dtype`` tensor of ``shape`` in ``memory`` at int32 row ``row``,
        in its TPU layout."""

    def reshape(self, src: int, shape: Sequence[int]) -> int: ...
    def ref_bitcast(self, src: int, dtype: str) -> int: ...
    def load(self, src: int, indices: Sequence[int] = ()) -> int: ...
    def store(self, dst: int, value: int, indices: Sequence[int] = ()) -> None: ...
    def load_strided(self, src: int, starts: Sequence[int], sizes: Sequence[int], strides: Sequence[int]) -> int: ...
    def store_strided(self, dst: int, value: int, starts: Sequence[int], strides: Sequence[int]) -> None: ...
    def smem(self, dtype: str, shape: Sequence[int]) -> int: ...
    def dma(self, src: int, dst: int, sem: int, wait: bool) -> None: ...
    def delay(self, nanos: int) -> None: ...
    def begin_if(self, cond: int) -> None: ...
    def begin_else(self, results: Sequence[int]) -> None: ...
    def end_if(self, results: Sequence[int] = ()) -> list[int]: ...
    def begin_while(self, carried: Sequence[int]) -> list[int]: ...
    def begin_while_body(self, cond: int) -> list[int]: ...
    def end_while(self, results: Sequence[int]) -> list[int]: ...
    def begin_for(self, lo: int, hi: int, carried: Sequence[int]) -> tuple[int, list[int]]: ...
    def end_for(self, results: Sequence[int]) -> list[int]: ...
    def lower(self, name: str) -> str:
        """The kernel as Mosaic (libtpu's serialized form), its function
        named ``name``."""

    def _set_source(self, var: int, file: str, line: int) -> None: ...
    def _set_scope(self, ranges: Sequence[tuple[str, int]]) -> None: ...
