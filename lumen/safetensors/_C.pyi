import os
from typing import Any, Sequence

from lumen.device._C import DeviceLike
from lumen.tensor._C import Tensor

class safe_open:
    """An open safetensors file, read a tensor at a time (``lumen.safetensors``)."""

    def __init__(self, filename: str | "os.PathLike[str]", device: DeviceLike | None = None) -> None: ...
    def keys(self) -> list[str]: ...
    def offset_keys(self) -> list[str]: ...
    def metadata(self) -> dict[str, str] | None: ...
    def get_tensor(self, name: str, device: DeviceLike | None = None) -> Tensor:
        """On ``device`` (default: the file's); on ``"meta"``, nothing is read."""

    def get_tensors(self) -> list[tuple[str, Tensor]]: ...
    def close(self) -> None: ...
    def __enter__(self) -> "safe_open": ...
    def __exit__(self, *args: Any) -> None: ...

def _safetensors_serialize(tensors: Sequence[tuple[str, Tensor]], metadata: dict[str, str] | None = None) -> bytes: ...
def _safetensors_save_file(
    tensors: Sequence[tuple[str, Tensor]], path: str, metadata: dict[str, str] | None = None
) -> None: ...
def _safetensors_deserialize(data: bytes, device: DeviceLike | None = None) -> list[tuple[str, Tensor]]: ...
