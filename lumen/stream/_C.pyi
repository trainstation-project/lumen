from __future__ import annotations

from typing import Optional, Union, final

from lumen.device._C import device
from lumen.tensor._C import Tensor

@final
class Stream:
    """A device's stream, modeled on ``torch.Stream``: the queue its ops
    submit work to without waiting."""

    def __new__(cls, device: Optional[Union[str, device]] = None, *, stream_id: int = 0) -> "Stream": ...
    @property
    def device(self) -> device: ...
    @property
    def stream_id(self) -> int: ...
    def synchronize(self) -> None: ...
    def wait_stream(self, other: "Stream") -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def command_buffer(self) -> int: ...
    def buffer(self, tensor: Tensor) -> tuple[int, int]: ...

@final
class Event:
    """A point in a device's stream, modeled on ``torch.cuda.Event``:
    ``record()`` marks it after the work submitted so far; with
    ``enable_timing``, ``elapsed_time(end)`` is the device time between two
    events in milliseconds."""

    def __new__(cls, device: Optional[Union[str, device]] = None, *, enable_timing: bool = False) -> "Event": ...
    @property
    def device(self) -> device: ...
    @property
    def enable_timing(self) -> bool: ...
    def record(self) -> None: ...
    def query(self) -> bool: ...
    def synchronize(self) -> None: ...
    def elapsed_time(self, end: "Event") -> float: ...

@final
class CudaGraph:
    """lumen's kernel launches on a CUDA device, captured once and replayed
    (CUDA builds only): creating it starts capturing, ``end()`` instantiates
    what was launched, ``stage(dst, src)`` copies an input in on its stream
    and ``replay()`` launches it all again. Memory taken while
    capturing stays the graph's until it is dropped."""

    def __new__(cls, device: Optional[Union[str, device]] = None) -> "CudaGraph": ...
    @property
    def stream(self) -> int: ...
    def end(self) -> None: ...
    def stage(self, dst: Tensor, src: Tensor) -> None: ...
    def replay(self) -> None: ...
