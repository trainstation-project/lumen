"""The part of `lumen._C` that ``lumen/stream/python.rs`` defines (see
``lumen/_C.pyi``)."""

from typing import Optional, Sequence, Union, final

from lumen.device import device
from lumen.tensor._C import Tensor

@final
class Stream:
    """A device's stream, modeled on ``torch.Stream``: the queue its ops
    submit work to without waiting."""

    def __new__(cls, device: Optional[Union[str, device]] = None) -> "Stream": ...
    @property
    def device(self) -> str: ...
    def synchronize(self) -> None: ...

def _mps_compile(source: str, name: Optional[str] = None) -> tuple[str, str]: ...
def _mps_launch(
    key: str, name: str, tensors: Sequence[Tensor], args: Sequence[bytes], grid: tuple[int, int, int], groups: bool
) -> None: ...
def _mps_command_buffer() -> int: ...
def _mps_buffer(t: Tensor) -> tuple[int, int]: ...
def _cuda_is_available() -> bool: ...
def _cuda_stream_wait(index: int, stream: int) -> None: ...
