 "code": {
  "kernel": "// step 0: concatenate\n// { lambda %0:f32[524288] %1:f32[524288]. let\n//     %2:f32[1048576] = concatenate[dimension=0] %0 %1\n//   in (%2) }\n\nimport cuda.bindings.driver as cuda\nimport cutlass\nimport cutlass.cute as cute\nfrom cutlass import Int32\n\nfrom lumen.codegen.elementwise.cuda.kernel import ElementwiseKernel\n\n\n@cute.jit\ndef BODY(ins, outs, j, SEGMENT: cutlass.Constexpr):\n    \"\"\"Every output of segment `SEGMENT` at flat index `j`.\"\"\"\n    in0 = ins[0]\n    in1 = ins[1]\n    out0 = outs[0]\n    if cutlass.const_expr(SEGMENT == 0):\n        i0 = (j // 1) % 1048576\n        i1 = 0 + cutlass.min(cutlass.max(i0 - 0, 0), 524287) * 1\n        v2 = in0[i1]\n        i3 = 0 + cutlass.min(cutlass.max(i0 - 524288, 0), 524287) * 1\n        v4 = in1[i3]\n        v5 = cutlass.select_(i0 < 524288, v2, v4)\n        out0[j] = v5\n\n\n@cute.jit\ndef launch(in0, in1, out0, blocks: Int32, stream: cuda.CUstream):\n    \"\"\"Runs the fusion's `ElementwiseKernel` on `blocks` blocks on `stream`.\"\"\"\n    ElementwiseKernel(BODY, (1048576, )).launch([in0, in1], [out0], blocks, stream)",
